{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",

  "layer": "overlay",

  "control-center-width": 320,
  "control-center-height": 620,

  "notification-window-width": 300,

  "fit-to-screen": true,

  "notification-icon-size": 28,
  "notification-body-image-height": 80,
  "notification-body-image-width": 160,

  "timeout": 2,
  "timeout-low": 2,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",

  "transition-time": 150,

  "hide-on-clear": true,
  "hide-on-action": true,

  "script-fail-notify": false,

  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notificaciones",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },

    "dnd": {
      "text": "No molestar"
    }
  }
}
