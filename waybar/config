 {
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,

  "modules-left": [
    "sway/workspaces"
  ],

  "modules-center": [
    "sway/window"
  ],

  "modules-right": [
    "custom/wlogout",
    "pulseaudio",
    "backlight",
    "network",
    "bluetooth",
    "battery",
    "clock",
    "custom/notifications",
    "tray"
  ],

  "custom/wlogout": {
    "format": "⏻",
    "tooltip": "Logout / Power menu",
    "on-click": "wlogout",
    "interval": 0
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": "{icon} {percent}%"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "exec": "rfkill list bluetooth | grep -q 'Soft blocked: no' && echo '' || echo ''",
    "interval": 2,
    "on-click": "blueman-manager"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "clock": {
    "format": "{:%a %d %I:%M %p}"
  },

  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "escape": true,
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛"
    }
  },

  "tray": {
    "spacing": 8
  }
}
