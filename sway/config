# Copy this to ~/.config/sway/config and edit it to your liking.
### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty 
include /etc/sway/config-vars.d/*

## SHORCUT EDIT SWAY DOTFILE 
bindsym Mod1+Shift+u exec kitty -e nvim ~/.config/sway/config

### Output configuration screen borders
default_border pixel 2
default_floating_border pixel 2
smart_borders on

for_window [title=".*"] title_format ""

gaps inner 2 
gaps outer 2 
smart_gaps on

client.focused          #77dd77 #1e1e2e #ffffff #77dd77
client.focused_inactive #2a2a2a #1e1e2e #888888 #2a2a2a
client.unfocused        #1a1a1a #1e1e2e #666666 #1a1a1a
client.urgent           #ff5555 #1e1e2e #ffffff #ff5555

for_window [title=".*"] border pixel 2
for_window [app_id=".*"] title_format ""

# pantalla de bloqueo
#exec_always swayidle -w before-sleep 'swaylock -f -i /home/juanes/wallpaper/Arch-chan_to.png --indicator-radius 100 --indicator-thickness 7'

# wallpaper
output * bg /home/juanes/wallpaper/Anime-City-Night.png fill
#exec_always ~/.config/sway/scripts/random_wallpaper.sh

# wallpaper selector
bindsym Mod1+Shift+p exec ~/.config/sway/scripts/wallpaper_chooser.sh

# cargar wallpaper al iniciar
#exec_always ~/.config/sway/scripts/wallpaper_chooser.sh

## Grabar toda la pantalla con audio
bindsym $mod+Shift+r exec wf-recorder -a -f ~/Videos/$(date +'%Y-%m-%d_%H-%M-%S').mkv

# Grabar una región seleccionada con audio
bindsym $mod+Shift+g exec wf-recorder -a -g "$(slurp)" -f ~/Videos/$(date +'%Y-%m-%d_%H-%M-%S').mkv

# Detener grabación
bindsym $mod+Shift+x exec pkill wf-recorder

## Gestor de pantallas
bindsym $mod+p exec wdisplays

## Gestor de recursos
bindsym Ctrl+Shift+Escape exec kitty -e btop

## Modos de energia
bindsym Mod1+F9  exec powerprofilesctl set power-saver
bindsym Mod1+F10 exec powerprofilesctl set balanced
bindsym Mod1+F11 exec powerprofilesctl set performance

# FIX CRÍTICO PARA VLC / AUDIO / WAYLAND
exec_always dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_RUNTIME_DIR \
    XDG_CURRENT_DESKTOP=sway

# Asegurar audio (PipeWire + Pulse)
exec_always systemctl --user enable --now pipewire pipewire-pulse
exec_always nm-applet --indicator
exec_always wl-paste --watch cliphist store
exec_always /usr/lib/polkit-kde-authentication-agent-1
exec_always wob
#exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# VLC forzado a X11 (CLAVE)
set $vlc env GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb vlc

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+q kill
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

## APLICACIONES
bindsym $mod+b exec brave-browser
bindsym alt+Shift+o exec flatpak run md.obsidian.Obsidian 
bindsym $mod+e exec nemo 
bindsym $mod+c exec google-chrome-stable  
#bindsym Mod1+space exec wofi --show drun
bindsym Mod1+space exec fuzzel 
bindsym $mod+t exec flatpak run org.telegram.desktop
bindsym alt+Shift+f exec flatpak run app.zen_browser.zen 
bindsym alt+u exec gnome-calendar
bindsym alt+q exec gnome-clocks

## SITES
bindsym $mod+n exec brave-browser --app=https://www.notion.so/7072782b14f845239198f43c5400861d
bindsym $mod+w exec brave-browser --app=https://web.whatsapp.com
bindsym $mod+d exec brave-browser --app=https://drive.google.com/drive/my-drive 
bindsym $mod+i exec brave-browser --app=https://www.instagram.com/
bindsym alt+Shift+d exec brave-browser --app=https://discord.com/channels/@me

# Utilidades fuzzel
bindsym alt+m exec ~/.config/fuzzel/sitios/webs.sh
bindsym alt+Shift+i exec ~/.config/fuzzel/sitios/sites.sh

# anime local
bindsym alt+Shift+ntilde exec kitty -e bash -c 'cd "$HOME/Desktop/anime" && ranger'

## UDEA CLASES 

## SCRIPTS SHORTCUTS
bindsym $mod+x exec ~/.config/obsidian-script/start.sh 
# APAGAR PC
bindsym alt+Shift+m exec ~/apagar.sh 
# SWITCH THEMES WAYBAR
bindsym  alt+Shift+t exec ~/.config/waybar/switch-theme.sh
# INTERRUPTOR DE WAYBAR
bindsym alt+Shift+j exec ~/.config/sway/scripts/toggle.sh
# INTERRUPTOR DE WIFI 1 solor reiniciar
bindsym alt+Shift+l exec ~/.config/sway/scripts/mejorar.wifi.sh
# INTERRUPTOR DE WIFI 2 conectar al la red de mi casa directamente 
bindsym alt+Shift+k exec ~/.config/sway/scripts/wifi.sh

### Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

## move windows 
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

